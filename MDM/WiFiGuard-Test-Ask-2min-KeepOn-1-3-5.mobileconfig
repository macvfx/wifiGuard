<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadContent</key>
			<dict>
				<key>com.wifiguard.app</key>
				<dict>
					<key>Forced</key>
					<array>
						<dict>
							<key>mcx_preference_settings</key>
							<dict>
								<key>allowSnooze</key>
								<true/>
								<key>intervalMinutes</key>
								<integer>2</integer>
								<key>lockoutGuard</key>
								<true/>
								<key>mode</key>
								<string>ask</string>
								<key>snoozeOptions</key>
								<string>1, 3, 5</string>
							</dict>
						</dict>
					</array>
				</dict>
			</dict>
			<key>PayloadDisplayName</key>
			<string>Wi-Fi Guard Test: Ask, 2 min, keep-on 1/3/5 settings</string>
			<key>PayloadIdentifier</key>
			<string>com.example.wifiguard.test-ask-2min-keepon.settings</string>
			<key>PayloadType</key>
			<string>com.apple.ManagedClient.preferences</string>
			<key>PayloadUUID</key>
			<string>E3368ECC-5CC6-48FE-867A-5965F76B88F8</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
		</dict>
	</array>
	<key>PayloadDescription</key>
	<string>Test profile for Wi-Fi Guard. Locks the listed settings, including the keep-on durations.</string>
	<key>PayloadDisplayName</key>
	<string>Wi-Fi Guard Test: Ask, 2 min, keep-on 1/3/5</string>
	<key>PayloadIdentifier</key>
	<string>com.example.wifiguard.test-ask-2min-keepon</string>
	<key>PayloadOrganization</key>
	<string>Example Org</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>F2091CAA-9621-41FD-87FF-1F25492E1358</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
