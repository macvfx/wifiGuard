<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadContent</key>
			<dict>
				<key>com.wifiguard.app</key>
				<dict>
					<key>Forced</key>
					<array>
						<dict>
							<key>mcx_preference_settings</key>
							<dict>
								<key>allowSnooze</key>
								<true/>
								<key>dockBadge</key>
								<true/>
								<key>intervalMinutes</key>
								<integer>2</integer>
								<key>launchAtLogin</key>
								<true/>
								<key>lockoutGuard</key>
								<true/>
								<key>logKeep</key>
								<integer>8</integer>
								<key>logRotation</key>
								<string>weekly</string>
								<key>mode</key>
								<string>silent</string>
								<key>notifyIntervalMinutes</key>
								<integer>60</integer>
								<key>notifyOnAutoOff</key>
								<true/>
								<key>showInDock</key>
								<true/>
							</dict>
						</dict>
					</array>
				</dict>
			</dict>
			<key>PayloadDisplayName</key>
			<string>Wi-Fi Guard Test: Auto-off with notice, login and Dock settings</string>
			<key>PayloadIdentifier</key>
			<string>com.example.wifiguard.test-auto-notify.settings</string>
			<key>PayloadType</key>
			<string>com.apple.ManagedClient.preferences</string>
			<key>PayloadUUID</key>
			<string>A914BAD2-77FC-43D8-9839-A2854713ACC2</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
		</dict>
	</array>
	<key>PayloadDescription</key>
	<string>Test profile for Wi-Fi Guard. Turns Wi-Fi off automatically with a notification, forces open at login, the Dock icon and the log settings.</string>
	<key>PayloadDisplayName</key>
	<string>Wi-Fi Guard Test: Auto-off with notice, login and Dock</string>
	<key>PayloadIdentifier</key>
	<string>com.example.wifiguard.test-auto-notify</string>
	<key>PayloadOrganization</key>
	<string>Example Org</string>
	<key>PayloadScope</key>
	<string>System</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>6F85B200-785C-4D16-B9A5-1BCB34A92BCA</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
